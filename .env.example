# .env.example
# Copy to .env.local for `npm run dev`. Do not commit real keys.

VITE_BASE_URL=https://silverbackai.agency

# Legacy workshop image generation only. Not required for the agency pages.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Soft-open face. false (or unset) keeps SilverbackFront on `/`.
# true swaps `/` to the soft-open page. `/?face=live` still shows SilverbackFront.
VITE_SOFT_OPEN=false

# Browser posts here. Default is the same-origin stub.
VITE_CONTACT_ENDPOINT=/api/contact

# Server-side only (Cloudflare Pages secrets). The /api/contact stub does not read these
# and will not send mail until a later change wires a provider.
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
# RESEND_API_KEY=
